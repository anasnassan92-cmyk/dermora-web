# ---- Server ----
NODE_ENV=development
PORT=4000
# Folder for uploads, the auto-generated JWT secret and the local SQLite file.
# Defaults: ./.data locally, ~/dermora-data in production.
DATA_DIR=
# Optional. If empty, a random secret is generated once and stored in DATA_DIR/jwt-secret.
JWT_SECRET=
# Comma-separated e-mails that get access to /admin
ADMIN_EMAILS=admin@example.com

# ---- Database ----
# Leave DB_HOST empty to use local SQLite (node:sqlite).
DB_HOST=
DB_PORT=3306
DB_NAME=dermora
DB_USER=dermora
DB_PASSWORD=
SQLITE_FILE=./.data/dermora.db

# ---- Google Gemini (AI analysis + chat). Empty = mock provider ----
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_ANALYSIS_MODEL=gemini-flash-latest
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_ANALYSIS_THINKING=512
GEMINI_CHAT_THINKING=0

# ---- Google Cloud Vision (face detection). Empty = local sharpness/brightness check ----
GOOGLE_VISION_API_KEY=

# ---- Google Sign-In (OAuth client IDs) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_ANDROID_CLIENT_ID=

# ---- SMTP for 6-digit e-mail codes. Empty = demo mode (code returned to the app) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dermora <no-reply@example.com>

# ---- Tests only: import the app without starting the listener ----
DERMORA_NO_LISTEN=
